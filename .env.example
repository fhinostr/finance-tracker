# Plaid API Configuration
# Get your keys at https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_plaid_secret_here

# Environment options: sandbox (testing) or development (up to 100 real live accounts)
PLAID_ENV=sandbox

# Comma-separated list of Plaid products to request
# 'transactions' connects checking/savings/credit cards
# 'investments' connects brokerage accounts like Robinhood
PLAID_PRODUCTS=transactions,investments

